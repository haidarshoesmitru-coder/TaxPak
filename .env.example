# Brand + domain (change when final name is decided)
NEXT_PUBLIC_SITE_NAME=TaxPak
NEXT_PUBLIC_SITE_URL=https://yourdomain.pk

# OPTIONAL: Supabase. Without these the site runs on lib/rules/*.ts files.
# With them, published rows in tax_rules override local rules (no redeploy needed).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
